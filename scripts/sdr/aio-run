#!/bin/bash
# aio-run: power the AIO V2 rails an app needs, run it, power them down after.
#
#   aio-run SDR -- gqrx
#   aio-run SDR,GPS -- direwolf ...
#   aio-run --reap     switch off rails that aio-run turned on and nothing holds
#
# Rails are reference counted per user session, so two apps sharing the SDR do
# not cut each other off. A rail that was already on before the first aio-run
# claimed it (switched on by hand, or a boot default) is left on afterwards.
# Install to /usr/local/bin/aio-run. Needs the gpio group (pinctrl without root).
set -u

declare -A PIN=([SDR]=7 [GPS]=27 [LORA]=16 [USB]=23)
STATE="${XDG_RUNTIME_DIR:-/tmp/aio-run-$UID}/aio-rails"
mkdir -p "$STATE"

usage() { echo "usage: aio-run RAIL[,RAIL...] -- command [args...] | aio-run --reap" >&2; exit 2; }
is_on() { pinctrl get "${PIN[$1]}" 2>/dev/null | grep -q '| hi'; }
notify() { command -v omarchy-notification-send >/dev/null && omarchy-notification-send "$@" >/dev/null 2>&1 || true; }

# prune holders whose process is gone; print how many remain
holders() {
  local d="$STATE/$1" n=0 f
  mkdir -p "$d"
  for f in "$d"/*; do
    [[ -e $f ]] || continue
    if kill -0 "${f##*/}" 2>/dev/null; then n=$((n + 1)); else rm -f "$f"; fi
  done
  echo "$n"
}

# Safety net: if an aio-run was killed before it could clean up (for example
# its whole app scope was torn down when the window closed), its rail is left
# on with no holder. Reaping switches such rails off. Runs at every start and
# from aio-reap.timer.
reap() {
  (
    flock 9
    local r
    for r in "${!PIN[@]}"; do
      if [[ -f $STATE/$r.restore && $(holders "$r") -eq 0 ]]; then
        aiov2_ctl "$r" off >/dev/null
        rm -f "$STATE/$r.restore"
      fi
    done
  ) 9>"$STATE/.lock"
}

if [[ ${1:-} == --reap ]]; then reap; exit 0; fi
[[ $# -ge 3 && $2 == -- ]] || usage
IFS=, read -ra RAILS <<<"${1^^}"
shift 2
for r in "${RAILS[@]}"; do [[ -n ${PIN[$r]:-} ]] || usage; done

acquire() {
  local r=$1
  (
    flock 9
    if [[ $(holders "$r") -eq 0 ]]; then
      if is_on "$r"; then
        rm -f "$STATE/$r.restore"          # someone else turned it on: leave it
      else
        echo off >"$STATE/$r.restore"
        aiov2_ctl "$r" on >/dev/null
      fi
    fi
    : >"$STATE/$r/$$"
  ) 9>"$STATE/.lock"
}

release() {
  local r=$1
  (
    flock 9
    rm -f "$STATE/$r/$$"
    if [[ $(holders "$r") -eq 0 && -f $STATE/$r.restore ]]; then
      aiov2_ctl "$r" off >/dev/null
      rm -f "$STATE/$r.restore"
    fi
  ) 9>"$STATE/.lock"
}

cleanup() {
  trap - EXIT INT TERM HUP
  [[ -n ${child:-} ]] && kill "$child" 2>/dev/null && wait "$child" 2>/dev/null
  for r in "${RAILS[@]}"; do release "$r"; done
}
trap cleanup EXIT
trap 'exit 130' INT TERM HUP

reap
for r in "${RAILS[@]}"; do acquire "$r"; done

# wait for the hardware to appear
for r in "${RAILS[@]}"; do
  case $r in
    SDR)
      for _ in $(seq 40); do lsusb -d 0bda:2838 >/dev/null 2>&1 && break; sleep 0.25; done
      lsusb -d 0bda:2838 >/dev/null 2>&1 || notify "AIO SDR did not appear on USB"
      sleep 0.5 ;;
    GPS) sleep 1 ;;
  esac
done

"$@" &
child=$!
wait "$child"
status=$?
child=
exit "$status"
