#!/usr/bin/python3
"""keyring-passwordless: move the default GNOME keyring to one with no password.

For uConsoles that log in automatically on tty1 (Omarchy's autologin): PAM
never sees a password, so a password-protected keyring asks to be unlocked
after every boot. Run this from the desktop session while the keyring is
unlocked (unlock it once if it asks). It creates a new keyring "Login" with an
empty password, copies every item into it unchanged (checking each copy),
and makes it the default. The old keyring is left in place; delete it from
Seahorse, or with --delete-old, once everything works.

Trade-off: anyone who can read your home directory can read these secrets.
With autologin, a login password did not protect them at rest either.

Back up first:  cp -a ~/.local/share/keyrings ~/.local/share/keyrings.bak
Needs python-dbus.
"""
import sys
import dbus

SVC = "org.freedesktop.secrets"
PROPS = "org.freedesktop.DBus.Properties"
COLL = "org.freedesktop.Secret.Collection"
ITEM = "org.freedesktop.Secret.Item"

bus = dbus.SessionBus()
svc_obj = bus.get_object(SVC, "/org/freedesktop/secrets")
svc = dbus.Interface(svc_obj, "org.freedesktop.Secret.Service")
guilt = dbus.Interface(svc_obj, "org.gnome.keyring.InternalUnsupportedGuiltRiddenInterface")
_, session = svc.OpenSession("plain", dbus.String("", variant_level=1))

old_path = svc.ReadAlias("default")
if old_path == "/":
    sys.exit("No default keyring.")
old = bus.get_object(SVC, old_path)
if dbus.Interface(old, PROPS).Get(COLL, "Locked"):
    sys.exit("The default keyring is locked. Unlock it (e.g. open Seahorse) and run again.")
items = dbus.Interface(old, PROPS).Get(COLL, "Items")
print(f"Default keyring {old_path}: {len(items)} items")

def secret(value):
    return dbus.Struct((session, dbus.ByteArray(b""), dbus.ByteArray(value), "text/plain"), signature="oayays")

new_path = guilt.CreateWithMasterPassword(
    {COLL + ".Label": dbus.String("Login", variant_level=1)}, secret(b""))
new = dbus.Interface(bus.get_object(SVC, new_path), COLL)

for p in items:
    o = bus.get_object(SVC, p)
    label = dbus.Interface(o, PROPS).Get(ITEM, "Label")
    attrs = dbus.Interface(o, PROPS).Get(ITEM, "Attributes")
    s = dbus.Interface(o, ITEM).GetSecret(session)
    props = {
        ITEM + ".Label": dbus.String(label, variant_level=1),
        ITEM + ".Attributes": dbus.Dictionary(attrs, signature="ss", variant_level=1),
    }
    copy = dbus.Struct((session, dbus.ByteArray(bytes(s[1])), dbus.ByteArray(bytes(s[2])), s[3]), signature="oayays")
    np, _ = new.CreateItem(props, copy, False)
    n = bus.get_object(SVC, np)
    ns = dbus.Interface(n, ITEM).GetSecret(session)
    if bytes(ns[2]) != bytes(s[2]) or dict(dbus.Interface(n, PROPS).Get(ITEM, "Attributes")) != dict(attrs):
        sys.exit(f"Copy of {label!r} does not match; default keyring left unchanged.")
    print(f"  copied: {label}")

svc.SetAlias("default", new_path)
print(f"Default keyring is now {new_path} (no password).")
if "--delete-old" in sys.argv:
    dbus.Interface(old, COLL).Delete()
    print(f"Deleted {old_path}.")
