#!/usr/bin/env python3
# Route Bluetooth SCO (headset/call) audio over HCI on the CM4's BCM4345.
# By default the chip sends SCO to its PCM pins, so a headset's HFP microphone
# and earpiece carry silence on Linux. Raspberry Pi OS sends this same vendor
# command from bthelper. Install to /usr/local/bin/bt-sco-hci (mode 755).
import socket, struct, sys
OGF, OCF = 0x3F, 0x01C                     # Broadcom Write_SCO_PCM_Int_Param
params = bytes([0x01, 0x02, 0x00, 0x01, 0x01])  # routing=HCI, as in bthelper
s = socket.socket(socket.AF_BLUETOOTH, socket.SOCK_RAW, socket.BTPROTO_HCI)
s.bind((int(sys.argv[1]) if len(sys.argv) > 1 else 0,))
s.send(struct.pack("<BHB", 0x01, (OGF << 10) | OCF, len(params)) + params)
print("SCO routed over HCI")
