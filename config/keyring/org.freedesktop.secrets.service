# D-Bus activation for the Secret Service that goes through systemd.
# Install to ~/.local/share/dbus-1/services/org.freedesktop.secrets.service
# Without SystemdService=, D-Bus can start its own gnome-keyring-daemon at login
# while systemd starts gnome-keyring-daemon.service, leaving two daemons racing
# for the same bus name.
[D-BUS Service]
Name=org.freedesktop.secrets
Exec=/usr/bin/gnome-keyring-daemon --start --foreground --components=secrets
SystemdService=gnome-keyring-daemon.service
